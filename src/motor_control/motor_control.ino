// =============================================================
// Arduino Uno + MD20A x2
//
// LEFT MOTOR
// PWM = D9  (OC1A / Timer1)
// DIR = D8
//
// RIGHT MOTOR
// PWM = D10 (OC1B / Timer1)
// DIR = D12
//
// Raspberry Pi command:
// -255 ~ +255
//
// 예)
//  100,100
//  180,80
// -120,-120
//
// PWM frequency = 20 kHz
// Watchdog = 500 ms
// Serial baud = 9600
//
// Encoder = NOT USED
// =============================================================


// =============================================================
// Motor pins
// =============================================================

const int PWM_L = 9;
const int DIR_L = 8;

const int PWM_R = 10;
const int DIR_R = 12;


// =============================================================
// Serial
// =============================================================

String serialBuffer = "";


// =============================================================
// Watchdog
// =============================================================

unsigned long lastCommandTime = 0;

const unsigned long COMMAND_TIMEOUT = 500;


// =============================================================
// Timer1 PWM
//
// Arduino Uno clock = 16 MHz
//
// Fast PWM Mode 14
// TOP = ICR1
//
// PWM frequency:
//
// 16,000,000 / (1 × (799 + 1))
// = 20,000 Hz
//
// = 20 kHz
// =============================================================

const uint16_t PWM_TOP = 799;


// =============================================================
// Timer1 20 kHz setup
//
// D9  = OC1A
// D10 = OC1B
// =============================================================

void setupMotorPWM20kHz()
{
    // PWM pins
    pinMode(PWM_L, OUTPUT);
    pinMode(PWM_R, OUTPUT);


    // ---------------------------------------------------------
    // Timer1 reset
    // ---------------------------------------------------------

    TCCR1A = 0;
    TCCR1B = 0;

    TCNT1 = 0;


    // ---------------------------------------------------------
    // Fast PWM Mode 14
    //
    // WGM13:WGM10 = 1110
    //
    // TOP = ICR1
    // ---------------------------------------------------------

    TCCR1A |=
        (1 << WGM11);

    TCCR1B |=
        (1 << WGM13)
        |
        (1 << WGM12);


    // ---------------------------------------------------------
    // Non-inverting PWM
    //
    // OC1A = D9
    // OC1B = D10
    // ---------------------------------------------------------

    TCCR1A |=
        (1 << COM1A1)
        |
        (1 << COM1B1);


    // ---------------------------------------------------------
    // TOP
    // ---------------------------------------------------------

    ICR1 = PWM_TOP;


    // ---------------------------------------------------------
    // Prescaler = 1
    // ---------------------------------------------------------

    TCCR1B |=
        (1 << CS10);


    // ---------------------------------------------------------
    // Start stopped
    // ---------------------------------------------------------

    OCR1A = 0;
    OCR1B = 0;
}


// =============================================================
// - PWM command 0 ~ 255
// - Timer1 compare 0 ~ 799
// =============================================================

uint16_t pwmToTimerValue(int pwm)
{
    pwm = constrain(
        pwm,
        0,
        255
    );


    unsigned long timerValue =
        (
            (unsigned long)pwm
            *
            PWM_TOP
        )
        /
        255;


    return (uint16_t)timerValue;
}


// =============================================================
// LEFT MOTOR
// =============================================================

void setLeftMotor(int speed)
{
    speed = constrain(
        speed,
        -255,
        255
    );


    if (speed > 0)
    {
        // Forward
        digitalWrite(
            DIR_L,
            LOW
        );


        OCR1A =
            pwmToTimerValue(
                speed
            );
    }

    else if (speed < 0)
    {
        // Reverse
        digitalWrite(
            DIR_L,
            HIGH
        );


        OCR1A =
            pwmToTimerValue(
                -speed
            );
    }

    else
    {
        // Stop
        OCR1A = 0;
    }
}


// =============================================================
// RIGHT MOTOR
// =============================================================

void setRightMotor(int speed)
{
    speed = constrain(
        speed,
        -255,
        255
    );


    if (speed > 0)
    {
        // Forward
        digitalWrite(
            DIR_R,
            LOW
        );


        OCR1B =
            pwmToTimerValue(
                speed
            );
    }

    else if (speed < 0)
    {
        // Reverse
        digitalWrite(
            DIR_R,
            HIGH
        );


        OCR1B =
            pwmToTimerValue(
                -speed
            );
    }

    else
    {
        // Stop
        OCR1B = 0;
    }
}


// =============================================================
// BOTH MOTORS
// =============================================================

void setMotors(
    int leftSpeed,
    int rightSpeed
)
{
    setLeftMotor(
        leftSpeed
    );

    setRightMotor(
        rightSpeed
    );
}


// =============================================================
// SERIAL COMMAND
//
// Format:
//
// LEFT,RIGHT
//
// Example:
//
// 120,120
// 180,80
// -100,-100
// =============================================================

void processCommand(
    String command
)
{
    command.trim();


    int commaIndex =
        command.indexOf(',');


    if (commaIndex < 0)
    {
        return;
    }


    int leftSpeed =
        command.substring(
            0,
            commaIndex
        ).toInt();


    int rightSpeed =
        command.substring(
            commaIndex + 1
        ).toInt();


    // ---------------------------------------------------------
    // Clamp
    // ---------------------------------------------------------

    leftSpeed =
        constrain(
            leftSpeed,
            -255,
            255
        );


    rightSpeed =
        constrain(
            rightSpeed,
            -255,
            255
        );


    // ---------------------------------------------------------
    // Motor output
    // ---------------------------------------------------------

    setMotors(
        leftSpeed,
        rightSpeed
    );


    // ---------------------------------------------------------
    // Watchdog reset
    // ---------------------------------------------------------

    lastCommandTime =
        millis();
}


// =============================================================
// SETUP
// =============================================================

void setup()
{
    // ---------------------------------------------------------
    // Serial
    // ---------------------------------------------------------

    Serial.begin(
        9600
    );


    // ---------------------------------------------------------
    // Direction pins
    // ---------------------------------------------------------

    pinMode(
        DIR_L,
        OUTPUT
    );

    pinMode(
        DIR_R,
        OUTPUT
    );


    digitalWrite(
        DIR_L,
        LOW
    );

    digitalWrite(
        DIR_R,
        LOW
    );


    // ---------------------------------------------------------
    // 20 kHz PWM
    // ---------------------------------------------------------

    setupMotorPWM20kHz();


    // ---------------------------------------------------------
    // Stop
    // ---------------------------------------------------------

    setMotors(
        0,
        0
    );


    // ---------------------------------------------------------
    // Watchdog timer
    // ---------------------------------------------------------

    lastCommandTime =
        millis();


    Serial.println(
        "READY,20KHZ,NO_ENCODER"
    );
}


// =============================================================
// LOOP
// =============================================================

void loop()
{
    // =========================================================
    // Pi -> Uno serial
    // =========================================================

    while (
        Serial.available()
        >
        0
    )
    {
        char c =
            Serial.read();


        // -----------------------------------------------------
        // Command complete
        // -----------------------------------------------------

        if (c == '\n')
        {
            processCommand(
                serialBuffer
            );

            serialBuffer = "";
        }


        // -----------------------------------------------------
        // Ignore carriage return
        // -----------------------------------------------------

        else if (c != '\r')
        {
            serialBuffer += c;


            // 너무 긴 이상 명령 방지
            if (
                serialBuffer.length()
                >
                50
            )
            {
                serialBuffer = "";
            }
        }
    }


    // =========================================================
    // Watchdog
    // =========================================================

    if (
        millis()
        -
        lastCommandTime
        >
        COMMAND_TIMEOUT
    )
    {
        setMotors(
            0,
            0
        );
    }
}